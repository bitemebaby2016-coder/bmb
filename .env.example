# ============================================
# Bite Me Baby — Environment Variables
# Copy this file to .env and fill in your keys
# ⚠️ DO NOT commit .env to version control
# ============================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# F-17 (Wave 1): server-side secrets (service_role / OpenRouter key / Stripe secret / webhook secret) must NOT live in VITE_* env - set via supabase secrets set (see supabase/secrets.local.env)

# OpenRouter — AI Chat (chat completions)

# Model A — primary chat model (owner directive 2026-10-01, supersedes 2026-09-25)
# Primary  : Qwen 3.7 Flash             → qwen/qwen3.7-flash            (OpenRouter, ~free)
# Fallback : Z-AI GLM 5.3 Flash         → z-ai/glm-5.3-flash            (OpenRouter, ~free)
# Both ids verified against https://openrouter.ai/api/v1/models on 2026-10-01.
VITE_OPENROUTER_MODEL=qwen/qwen3.7-flash

# AI Voice (WS-2f, 2026-10-01) — ผู้ช่วยเสียงแบบเรียลไทม์
# เปิดใช้เสียงสังเคราะห์ server-side (voice-tts EF: Edge-TTS → Google TTS → Botnoi)
# ปล่อยว่าง = ใช้เสียงของ browser (speechSynthesis) เหมือนเดิม
VITE_VOICE_SERVER_TTS=1
# Server-side secrets (supabase secrets set) — ไม่ใส่ใน VITE_*:
#   GROQ_API_KEY  → fallback STT whisper-large-v3 (ai-proxy mode=transcribe)
#   BOTNOI_API_KEY → fallback TTS เสียงไทย Botnoi (voice-tts EF)

# Stripe — Payment (test mode; owner must provide real test keys)
# status 2026-09-17: BLOCKED (keys not provided yet). Code path is ready in src/lib/paymentGateway.ts
# NOTE: อย่า commit ค่าจริงลง repo — GitHub Push Protection จะ block (secret scanning)
VITE_STRIPE_PUBLISHABLE_KEY=

# Omise — ย้ายค่ายคิดเงิน (TEST MODE) 2026-10-07 — ดู handoff cutover
# published key ฝั่ง client (Omise.js), secret key ฝั่ง server (supabase secrets set)
# NOTE: ชื่อไม่มี VITE_ prefix ตามที่ owner กำหนด — vite.config มี envPrefix ครอบชื่อนี้ให้ client อ่านได้
OMISE_PUBLISHED_API_KEY_TEST_MODE=
OMISE_SECRET_API_KEY_TEST_MODE=

# External Delivery Providers — sandbox API (Grab / LINE MAN)
# status 2026-09-17: BLOCKED (sandbox credentials not provided). Offline logic
# tests live in src/__tests__/api.test.ts (Delivery Providers sandbox suite)
VITE_GRAB_SANDBOX_CLIENT_ID=
VITE_GRAB_SANDBOX_CLIENT_SECRET=
VITE_LINEMAN_SANDBOX_API_KEY=

# Google Maps Platform — Routing / Places / Maps JavaScript API
# status: REQUIRED for production routing & ETA (P0)
# Get keys from Google Cloud Console → APIs & Services → Credentials
# Enable: Routes API, Places API, Maps JavaScript API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_GOOGLE_ROUTES_API_KEY=

# Mapbox (fallback routing provider)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_URL=

VITE_DELIVERY_KITCHEN_LAT=10.7016
VITE_DELIVERY_KITCHEN_LNG=102.1429
