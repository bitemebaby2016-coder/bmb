# ============================================
# Bite Me Baby — Environment Variables
# Copy this file to .env and fill in your keys
# ⚠️ DO NOT commit .env to version control
# ============================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenRouter — AI Chat (chat completions)
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model A — primary chat model (owner directive 2026-09-17)
# Primary  : GLM 5.2 (free)   → z-ai/glm-5.2:free   (OpenRouter, $0)
# Fallback : Qwen 3.7 Flash   → qwen/qwen3.7-flash  (used automatically if Model A fails)
VITE_OPENROUTER_MODEL=z-ai/glm-5.2:free
